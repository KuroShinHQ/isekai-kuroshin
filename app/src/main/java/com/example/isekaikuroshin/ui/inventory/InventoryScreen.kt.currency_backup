@Composable
private fun EquipmentSlotsPanel(
    slots: List<EquipmentSlotState>,
    modifier: Modifier = Modifier
) {
    LazyVerticalGrid(
        columns = GridCells.Fixed(3),
        modifier = modifier,
        horizontalArrangement = Arrangement.spacedBy(12.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        items(slots) { slot ->
            CompactEquipmentSlot(
                slotName = slot.slotName,
                equippedItem = slot.item
            )
        }
    }
}

@Composable
private fun CompactEquipmentSlot(
    slotName: String,
    equippedItem: CardData.ItemCard?,
    modifier: Modifier = Modifier
) {
    val infiniteTransition = rememberInfiniteTransition(label = "compact_slot_glow")
    val borderAlpha by infiniteTransition.animateFloat(
        initialValue = 0.2f,
        targetValue = 0.4f,
        animationSpec = infiniteRepeatable(
            animation = tween(2000, easing = EaseInOut),
            repeatMode = RepeatMode.Reverse
        ),
        label = "border_alpha"
    )

    Box(
        modifier = modifier
            .size(64.dp) // Çok daha küçük
            .background(
                color = if (equippedItem != null)
                    equippedItem.rarity.color.copy(alpha = 0.1f)
                else
                    Color(0xFF0A0F1A).copy(alpha = 0.8f),
                shape = RoundedCornerShape(8.dp)
            )
            .border(
                width = 1.dp,
                color = if (equippedItem != null)
                    equippedItem.rarity.color.copy(alpha = 0.6f)
                else
                    Color(0xFF00BFFF).copy(alpha = borderAlpha),
                shape = RoundedCornerShape(8.dp)
            ),
        contentAlignment = Alignment.Center
    ) {
        if (equippedItem != null) {
            // Equipped item - sadece ikon
            Icon(
                imageVector = getSlotIcon(slotName),
                contentDescription = slotName,
                tint = equippedItem.rarity.color.copy(alpha = 0.9f),
                modifier = Modifier.size(24.dp)
            )
        } else {
            // Empty slot - sadece ikon
            Icon(
                imageVector = getSlotIcon(slotName),
                contentDescription = slotName,
                tint = Color(0xFF00BFFF).copy(alpha = 0.5f),
                modifier = Modifier.size(20.dp)
            )
        }
    }
}

@Composable
private fun EquipmentSlot(
    slotName: String,
    equippedItem: CardData.ItemCard?,
    modifier: Modifier = Modifier
) {
    val infiniteTransition = rememberInfiniteTransition(label = "slot_glow")
    val borderAlpha by infiniteTransition.animateFloat(
        initialValue = 0.2f,
        targetValue = 0.5f,
        animationSpec = infiniteRepeatable(
            animation = tween(1500, easing = EaseInOut),
            repeatMode = RepeatMode.Reverse
        ),
        label = "border_alpha"
    )

    if (equippedItem != null) {
        // Equipped slot with miniature StandardCard using equipment type icon
        Box(
            modifier = modifier.height(120.dp)
        ) {
            val equipmentTypeIcon = getEquipmentTypeIcon(equippedItem.name)
            StandardCard(
                data = equippedItem.copy(imageRes = equipmentTypeIcon),
                modifier = Modifier.fillMaxSize()
            )
        }
    } else {
        // Empty slot
        Box(
            modifier = modifier
                .height(120.dp)
                .background(
                    color = Color(0xFF0A0F1A).copy(alpha = 0.8f),
                    shape = RoundedCornerShape(12.dp)
                )
                .border(
                    width = 1.dp,
                    color = Color(0xFF00BFFF).copy(alpha = borderAlpha),
                    shape = RoundedCornerShape(12.dp)
                ),
            contentAlignment = Alignment.Center
        ) {
            Column(
                horizontalAlignment = Alignment.CenterHorizontally,
                verticalArrangement = Arrangement.spacedBy(8.dp)
            ) {
                Icon(
                    imageVector = getSlotIcon(slotName),
                    contentDescription = slotName,
                    tint = Color(0xFF00BFFF).copy(alpha = 0.6f),
                    modifier = Modifier.size(32.dp)
                )
                Text(
                    text = slotName,
                    style = MaterialTheme.typography.bodySmall,
                    color = Color(0xFFE0F2F1).copy(alpha = 0.7f),
                    fontSize = 12.sp,
                    textAlign = TextAlign.Center,
                    maxLines = 1,
                    overflow = TextOverflow.Ellipsis
                )
            }
        }
    }
}

@Composable
private fun InventoryItemsPanel(
    items: List<CardData.ItemCard>,
    selectedFilter: InventoryFilter,
    onFilterChanged: (InventoryFilter) -> Unit,
    modifier: Modifier = Modifier
) {
        LazyColumn(
            modifier = modifier,
            verticalArrangement = Arrangement.spacedBy(16.dp)
        ) {
            items(items) { item ->
                val equipmentTypeIcon = getEquipmentTypeIcon(item.name)
                StandardCard(
                    data = item.copy(imageRes = equipmentTypeIcon),
                    modifier = Modifier.fillMaxWidth()
                )
            }
        }
}

@Composable
private fun FilterButtons(
    selectedFilter: InventoryFilter,
    onFilterChanged: (InventoryFilter) -> Unit,
    modifier: Modifier = Modifier
) {
    Row(
        modifier = modifier,
        horizontalArrangement = Arrangement.spacedBy(8.dp)
    ) {
        InventoryFilter.entries.forEach { filter ->
            FilterButton(
                filter = filter,
                isSelected = selectedFilter == filter,
                onClick = { onFilterChanged(filter) },
                modifier = Modifier.weight(1f)
            )
        }
    }
}

@Composable
private fun FilterButton(
    filter: InventoryFilter,
    isSelected: Boolean,
    onClick: () -> Unit,
    modifier: Modifier = Modifier
) {
    val animatedAlpha by animateFloatAsState(
        targetValue = if (isSelected) 1f else 0.6f,
        animationSpec = tween(200),
        label = "filter_alpha"
    )

    Button(
        onClick = onClick,
        colors = ButtonDefaults.buttonColors(
            containerColor = if (isSelected)
                Color(0xFF00BFFF).copy(alpha = 0.3f)
            else
                Color(0xFF0A0F1A).copy(alpha = 0.8f),
            contentColor = Color(0xFF00BFFF).copy(alpha = animatedAlpha)
        ),
        border = BorderStroke(
            1.dp,
            Color(0xFF00BFFF).copy(alpha = if (isSelected) 0.8f else 0.4f)
        ),
        shape = RoundedCornerShape(8.dp),
        modifier = modifier.height(36.dp)
    ) {
        Text(
            text = filter.displayName,
            fontWeight = if (isSelected) FontWeight.Bold else FontWeight.Normal,
            fontSize = 11.sp,
            maxLines = 1,
            overflow = TextOverflow.Ellipsis
        )
    }
}

// Helper function to get equipment type icon resource based on item type
private fun getEquipmentTypeIcon(itemName: String): Int {
    val lowerCaseName = itemName.lowercase()
    return when {
        lowerCaseName.contains("sword") || lowerCaseName.contains("kilic") || lowerCaseName.contains("kılıç") -> R.drawable.icon_kilic_seviye1
        lowerCaseName.contains("helmet") || lowerCaseName.contains("migfer") || lowerCaseName.contains("kafa") -> R.drawable.icon_migfer_seviye1
        lowerCaseName.contains("dagger") || lowerCaseName.contains("hancer") || lowerCaseName.contains("hançer") -> R.drawable.icon_hancer_seviye1
        lowerCaseName.contains("bow") || lowerCaseName.contains("yay") -> R.drawable.icon_yay_seviye1
        lowerCaseName.contains("potion") || lowerCaseName.contains("iksir") || lowerCaseName.contains("şişe") -> R.drawable.icon_iksir_seviye1
        else -> R.drawable.icon_kilic_seviye1 // Default to sword icon
    }
}

// Helper function to get appropriate icon for equipment slots
private fun getSlotIcon(slotName: String): ImageVector {
    return when (slotName) {
        "Kafa" -> Icons.Default.Security
        "Boyun" -> Icons.Default.Circle
        "Göğüs" -> Icons.Default.Shield
        "Bacaklar" -> Icons.Default.Straighten
        "Eldivenler" -> Icons.Default.PanTool
        "Ayakkabılar" -> Icons.AutoMirrored.Filled.DirectionsWalk
        "Ana El", "Yan El" -> Icons.Default.Build
        "Yüzük 1", "Yüzük 2" -> Icons.Default.Circle
        "Küpe 1", "Küpe 2" -> Icons.Default.Brightness1
        "Aura" -> Icons.Default.Flare
        "Relic 1", "Relic 2" -> Icons.Default.AutoAwesome
        "Evcil Hayvan" -> Icons.Default.Pets
        else -> Icons.Default.Category
    }
}

